  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:ui && npm run test:sprites",
    "test:logic": "vitest run",
    "test:ui": "jest --runInBand",
    "test:sprites": "node scripts/check-sprite-render.cjs",
    "test:watch": "vitest",
    "android:apk": "cd android && ./gradlew :app:assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "android:preview": "cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a,x86_64",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:share": "node scripts/share-android.mjs"
  },
  "private": true
